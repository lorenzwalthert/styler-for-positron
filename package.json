{
  "name": "styler",
  "displayName": "{styler}: Non-Invasive Pretty Printing of R Code",
  "description": "Format R code using the {styler} R package",
  "version": "0.0.1",
  "publisher": "lorenzwalthert",
  "author": {
    "name": "Lorenz Walthert"
  },
  "license": "MIT",
  "homepage": "https://github.com/lorenzwalthert/styler-formatter",
  "repository": {
    "type": "git",
    "url": "https://github.com/lorenzwalthert/styler-formatter.git"
  },
  "bugs": {
    "url": "https://github.com/lorenzwalthert/styler-formatter/issues"
  },
  "icon": "images/logo.png",
  "galleryBanner": {
    "color": "#2C3E50",
    "theme": "dark"
  },
  "keywords": [
    "r",
    "formatter",
    "styler",
    "tidyverse",
    "positron"
  ],
  "categories": [
    "Formatters"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:r"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "R Formatter",
      "properties": {
        "rFormatter.rscriptPath": {
          "type": "string",
          "default": "Rscript",
          "description": "Path to the Rscript binary. Defaults to 'Rscript' (resolved via PATH)."
        },
        "rFormatter.timeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "maximum": 300000,
          "description": "Subprocess timeout in milliseconds (clamped to [1000, 300000])."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "test": "node ./out/test/runTests.js",
    "test:unit": "TS_NODE_PROJECT=tsconfig.test.json mocha --require ts-node/register --require tsconfig-paths/register 'src/test/unit/**/*.test.ts'",
    "test:property": "TS_NODE_PROJECT=tsconfig.test.json mocha --require ts-node/register --require tsconfig-paths/register 'src/test/property/**/*.test.ts'",
    "test:integration": "npm run compile && node ./out/test/runTests.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/sinon": "^17.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.0.0",
    "@vscode/vsce": "^3.9.2",
    "fast-check": "^3.0.0",
    "mocha": "^10.0.0",
    "ovsx": "^1.0.1",
    "sinon": "^17.0.0",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
